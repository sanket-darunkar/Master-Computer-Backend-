# ============================================================
# Master Computer Academy – Certificate Verification System
# Environment Variables Reference
# ============================================================
# Copy this file to .env for local development.
# NEVER commit .env to version control (.gitignore already excludes it).
# On Render (or any cloud), set these as environment variables in the dashboard.
# ============================================================

# ---- Spring profile -------------------------------------
# Use "prod" on Render / staging servers.
# Use "dev" for local development.
SPRING_PROFILES_ACTIVE=prod

# ---- Port -----------------------------------------------
# Render injects PORT automatically – do NOT set this on Render.
# For local development, leave it unset (defaults to 8080) or set explicitly.
# SERVER_PORT=8080

# ---- Database -------------------------------------------
# Production (Render MySQL / PlanetScale / Aiven / etc.):
DB_URL=jdbc:mysql://<host>:<port>/<dbname>?useSSL=true&serverTimezone=Asia/Kolkata&requireSSL=true
# Development (local MySQL):
# DB_URL=jdbc:mysql://localhost:3306/mca_cert_dev?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true

DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ---- JWT ------------------------------------------------
# Generate a secure secret with:
#   openssl rand -base64 32
# The decoded key must be at least 32 bytes (256 bits) for HS256.
# NEVER use the placeholder below in any real environment.
JWT_SECRET=REPLACE_WITH_STRONG_BASE64_SECRET

# Token lifetime in milliseconds (default: 86400000 = 24 hours)
# JWT_EXPIRATION_MS=86400000

# ---- CORS – Frontend URL --------------------------------
# Production: exact origin of the frontend application.
# Multiple origins: comma-separated list (no spaces around commas).
# Do NOT use * in production.
#
# Production:
FRONTEND_URL=https://mastercomputeracademy.org
#
# Development (Vite default):
# FRONTEND_URL=http://localhost:5173
#
# Both at once (e.g. staging):
# FRONTEND_URL=https://mastercomputeracademy.org,http://localhost:5173

# ---- Admin seed (dev profile only) ----------------------
# These are only used by AdminSeeder which runs on the "dev" profile.
# AdminSeeder does NOT run in production (SPRING_PROFILES_ACTIVE=prod).
# Provide strong values even in dev – never use "1234" or "password".
ADMIN_EMAIL=admin@mastercomputeracademy.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
